<view style="padding:80rpx 48rpx;">
  <view style="display:flex;flex-direction:column;align-items:center;margin:30rpx 0 40rpx;">
    <view class="brand-mark">率</view>
    <view class="brand-title" style="margin-top:20rpx;">率土同盟数据库</view>
    <view class="muted" style="margin-top:8rpx;">武勋 / 势力值 / 贡献统计</view>
  </view>
  <view class="card">
    <view class="row" style="margin-bottom:24rpx;">
      <view class="tab {{mode==='login'?'active':''}}" bindtap="switchMode" data-mode="login">登录</view>
      <view class="tab {{mode==='signup'?'active':''}}" bindtap="switchMode" data-mode="signup">注册</view>
    </view>
    <input class="input" type="text" placeholder="邮箱" value="{{email}}" bindinput="onEmail" />
    <input class="input" password placeholder="密码" value="{{password}}" bindinput="onPassword" />
    <view class="remember-row">
      <switch checked="{{remember}}" bindchange="onRemember" color="#e0443c" />
      <text class="muted">记住账号和密码</text>
    </view>
    <button class="btn" loading="{{loading}}" bindtap="submit">{{mode==='login'?'登录':'注册'}}</button>
    <view class="muted" style="text-align:right;margin-top:16rpx;" bindtap="forgot">忘记密码？</view>
    <view class="muted" style="margin-top:16rpx;min-height:36rpx;">{{msg}}</view>
  </view>
</view>