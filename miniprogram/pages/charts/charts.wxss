.mbtn { flex: 1; text-align: center; padding: 12rpx 0; color: #c49da1; border: 1rpx solid #52242b; border-radius: 12rpx; font-size: 24rpx; }
.mbtn.active { background: linear-gradient(135deg, #e0443c, #ff6b5e); color: #fff; font-weight: 700; }
.rk { display: flex; align-items: center; gap: 12rpx; padding: 10rpx 0; }
.rk-name { width: 180rpx; font-size: 24rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.rk-bar { flex: 1; height: 20rpx; background: #39171e; border-radius: 10rpx; overflow: hidden; }
.rk-fill { height: 100%; background: linear-gradient(90deg, #e0443c, #ff6b5e); border-radius: 10rpx; }
.rk-val { width: 120rpx; text-align: right; font-size: 24rpx; }