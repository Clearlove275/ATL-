<view style="padding:24rpx;">
  <view class="card" style="margin-bottom:20rpx;">
    <view class="h3" style="margin-bottom:16rpx;">排行榜（前10）</view>
    <view class="row" style="margin-bottom:16rpx;">
      <view class="mbtn {{metric==='merit'?'active':''}}" bindtap="setMetric" data-m="merit">武勋</view>
      <view class="mbtn {{metric==='power'?'active':''}}" bindtap="setMetric" data-m="power">势力</view>
      <view class="mbtn {{metric==='ct'?'active':''}}" bindtap="setMetric" data-m="ct">贡献总量</view>
      <view class="mbtn {{metric==='cw'?'active':''}}" bindtap="setMetric" data-m="cw">贡献周量</view>
    </view>
    <view wx:for="{{ranking}}" wx:key="id" class="rk">
      <view class="rk-name">{{index+1}} {{item.name}}</view>
      <view class="rk-bar"><view class="rk-fill" style="width:{{item.pct}}%;"></view></view>
      <view class="rk-val">{{item.val}}</view>
    </view>
    <view wx:if="{{ranking.length===0}}" class="muted" style="text-align:center;padding:30rpx;">暂无数据</view>
  </view>

  <view class="card">
    <view class="h3" style="margin-bottom:16rpx;">个人趋势</view>
    <picker range="{{players}}" range-key="game_name" bindchange="pickTrendPlayer"><view class="input">{{selPid ? '已选择' : '请选择玩家'}}</view></picker>
    <canvas type="2d" id="trendCanvas" style="width:100%;height:360rpx;"></canvas>
  </view>
</view>