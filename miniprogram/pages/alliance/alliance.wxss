.grid { display: flex; flex-wrap: wrap; }
.gcell { width: 50%; box-sizing: border-box; padding: 12rpx 0; }
.num { font-size: 40rpx; font-weight: 800; }
.mask { position: fixed; inset: 0; background: rgba(0,0,0,.6); display: flex; align-items: flex-end; z-index: 10; }
.sheet { width: 100%; background: #2d1218; border-radius: 28rpx 28rpx 0 0; padding: 32rpx 28rpx 50rpx; }