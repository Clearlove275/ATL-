.grid { display: flex; flex-wrap: wrap; }
.gcell { width: 50%; box-sizing: border-box; padding: 12rpx 0; }
.num { font-size: 44rpx; font-weight: 800; }
.num-accent { color: #ff6b5e; }
.nav-btn { font-size: 24rpx !important; }
.mask { position: fixed; inset: 0; background: rgba(12,4,6,.72); display: flex; align-items: flex-end; z-index: 100; }
.sheet { width: 100%; background: #2d1218; border-radius: 28rpx 28rpx 0 0; padding: 32rpx 28rpx 60rpx; }
.batch-row { display: flex; align-items: center; padding: 16rpx 0; border-bottom: 1rpx solid rgba(82,36,43,.55); }
.batch-row .grow { flex: 1; }
.table { width: 100%; border: 1rpx solid #52242b; border-radius: 16rpx; overflow: hidden; }
.tr { display: flex; align-items: center; border-bottom: 1rpx solid rgba(82,36,43,.5); }
.tr:last-child { border-bottom: none; }
.tr.th { background: rgba(57,23,30,.65); }
.td { padding: 16rpx 6rpx; font-size: 24rpx; box-sizing: border-box; color: #f8eee9; }
.tr.th .td { color: #c49da1; font-size: 22rpx; font-weight: 600; }
.w-name { flex: 1; min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.w-name .rank { color: #c49da1; font-size: 22rpx; margin-right: 4rpx; }
.w-num { flex: 1; min-width: 0; text-align: right; font-variant-numeric: tabular-nums; }
.w-op { width: 88rpx; text-align: center; flex-shrink: 0; }