.grid { display: flex; flex-wrap: wrap; }
.gcell { width: 50%; box-sizing: border-box; padding: 12rpx 0; }
.num { font-size: 44rpx; font-weight: 800; }
.num-accent { color: #ff6b5e; }
.mask { position: fixed; inset: 0; background: rgba(12,4,6,.72); display: flex; align-items: flex-end; z-index: 100; }
.sheet { width: 100%; background: #2d1218; border-radius: 28rpx 28rpx 0 0; padding: 32rpx 28rpx 60rpx; }
.batch-row { display: flex; align-items: center; padding: 16rpx 0; border-bottom: 1rpx solid rgba(82,36,43,.55); }
.batch-row .grow { flex: 1; }