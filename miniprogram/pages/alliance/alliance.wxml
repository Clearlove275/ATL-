<view style="padding:24rpx;">
  <view class="card card-accent" style="margin-bottom:20rpx;">
    <view class="row"><view class="h2 grow">{{name}}</view><view class="pill">{{role==='owner'?'盟主':(role==='admin'?'管理':'成员')}}</view></view>
    <view class="muted" style="margin-top:8rpx;">{{season}} · 邀请码 {{code}}</view>
  </view>
  <view class="card" style="margin-bottom:20rpx;">
    <view class="h3" style="margin-bottom:16rpx;">数据概览</view>
    <view class="grid">
      <view class="gcell"><view class="num">{{stats.players||0}}</view><view class="muted">成员</view></view>
      <view class="gcell"><view class="num">{{stats.records||0}}</view><view class="muted">记录</view></view>
      <view class="gcell"><view class="num num-accent">{{stats.topMerit||0}}</view><view class="muted">最高武勋</view></view>
      <view class="gcell"><view class="num num-accent">{{stats.topPower||0}}</view><view class="muted">最高势力</view></view>
    </view>
  </view>
  <view class="row" style="margin-bottom:16rpx;"><button class="btn grow" bindtap="chooseImage">📷 截图识别</button><button class="btn-ghost grow" bindtap="chooseVideo">🎬 视频识别</button></view>
  <view class="row" style="margin-bottom:16rpx;"><button class="btn-ghost grow" bindtap="chooseCsv">📄 CSV 导入</button><button class="btn-ghost grow" bindtap="openAddPlayer">＋ 添加玩家</button></view>
  <view class="row" style="margin-bottom:16rpx;"><button class="btn-ghost grow nav-btn" bindtap="goCompare">变化值对比</button><button class="btn-ghost grow nav-btn" bindtap="goCharts">数据图表</button><button class="btn-ghost grow nav-btn" bindtap="goSettings">同盟设置</button></view>
  <view class="h3" style="margin:10rpx 0 16rpx;">成员数据</view>
  <view class="table">
    <view class="tr th">
      <view class="td w-name">玩家名称</view>
      <view class="td w-num">武勋</view>
      <view class="td w-num">势力</view>
      <view class="td w-num">总贡献</view>
      <view class="td w-num">周贡献</view>
      <view class="td w-op">操作</view>
    </view>
    <view class="tr" wx:for="{{players}}" wx:key="id">
      <view class="td w-name"><text class="rank">{{index+1}}.</text>{{item.game_name}}</view>
      <view class="td w-num">{{item.merit}}</view>
      <view class="td w-num">{{item.power}}</view>
      <view class="td w-num">{{item.ct}}</view>
      <view class="td w-num">{{item.cw}}</view>
      <view class="td w-op"><button class="btn-ghost" size="mini" style="font-size:22rpx;margin:0;padding:0 10rpx;line-height:1.6;" bindtap="addRecord" data-i="{{index}}">录入</button></view>
    </view>
  </view>
  <view wx:if="{{players.length===0}}" class="muted" style="text-align:center;padding:40rpx;">还没有成员，先添加玩家吧</view>
</view>
<view wx:if="{{showRec}}" class="mask" bindtap="closeRec"><view class="sheet" catchtap="">
  <view class="h3" style="margin-bottom:16rpx;">录入数据</view>
  <picker range="{{players}}" range-key="game_name" bindchange="pickPlayer"><view class="input">{{rec.name || '请选择玩家'}}</view></picker>
  <input class="input" type="number" placeholder="武勋" value="{{rec.merit}}" data-k="merit" bindinput="onRec" />
  <input class="input" type="number" placeholder="势力值" value="{{rec.power}}" data-k="power" bindinput="onRec" />
  <input class="input" type="number" placeholder="贡献总量" value="{{rec.ct}}" data-k="ct" bindinput="onRec" />
  <input class="input" type="number" placeholder="贡献周量" value="{{rec.cw}}" data-k="cw" bindinput="onRec" />
  <button class="btn" bindtap="saveRec">保存</button>
</view></view>
<view wx:if="{{showBatch}}" class="mask" bindtap="closeBatch"><view class="sheet sheet-tall" catchtap="">
  <view class="h3" style="margin-bottom:12rpx;">识别到 {{batchRows.length}} 名成员</view>
  <view class="muted" style="margin-bottom:12rpx;">核对无误后点批量保存，未匹配到的名字会新建玩家。</view>
  <scroll-view scroll-y style="max-height:50vh;">
    <view wx:for="{{batchRows}}" wx:key="index" class="batch-row">
      <view class="grow">{{item.name}}</view>
      <view class="muted">武{{item.merit}} 势{{item.power}} 贡{{item.ct}}/{{item.cw}}</view>
      <view class="muted" style="padding-left:16rpx;" bindtap="removeBatch" data-i="{{index}}">✕</view>
    </view>
  </scroll-view>
  <button class="btn" style="margin-top:16rpx;" loading="{{savingBatch}}" bindtap="saveBatch">批量保存</button>
</view></view>
<view wx:if="{{showPlayer}}" class="mask" bindtap="closePlayer"><view class="sheet" catchtap="">
  <view class="h3" style="margin-bottom:16rpx;">添加玩家</view>
  <input class="input" placeholder="游戏昵称" value="{{newPlayerName}}" bindinput="onNewPlayer" />
  <button class="btn" bindtap="savePlayer">保存</button>
</view></view>