<view style="padding:24rpx 24rpx 200rpx;">
  <view class="card" style="margin-bottom:20rpx;">
    <view class="h3" style="margin-bottom:12rpx;">发表反馈</view>
    <input class="input" placeholder="昵称（默认：匿名玩家）" value="{{nickname}}" bindinput="onNick" />
    <textarea class="input" placeholder="写下你的建议或反馈…" value="{{content}}" bindinput="onContent" auto-height maxlength="500" />
    <view wx:if="{{replyTo}}" class="muted" style="margin-bottom:10rpx;">正在回复：{{replyName}} <text style="color:#ff6b5e;" bindtap="cancelReply">取消</text></view>
    <button class="btn" bindtap="submit">发布</button>
  </view>
  <view wx:for="{{posts}}" wx:key="id" class="card" style="margin-bottom:16rpx;">
    <view class="row"><view class="h3 grow">{{item.nickname}}</view><view class="muted">{{item.time}}</view></view>
    <view style="margin-top:8rpx;">{{item.content}}</view>
    <view class="row" style="margin-top:12rpx;">
      <view class="like {{item.liked?'liked':''}}" bindtap="like" data-id="{{item.id}}">👍 {{item.like}}</view>
      <view class="muted" bindtap="reply" data-i="{{index}}">回复</view>
    </view>
    <view wx:if="{{item.replies.length}}" class="replies">
      <view wx:for="{{item.replies}}" wx:for-item="rp" wx:key="index" class="rp"><text class="rp-n">{{rp.nickname}}</text>：{{rp.content}} <text class="muted">{{rp.time}}</text></view>
    </view>
  </view>
  <view wx:if="{{posts.length===0}}" class="muted" style="text-align:center;padding:40rpx;">还没有反馈，来抢沙发吧～</view>
</view>