<view style="padding:24rpx;">
  <view class="card" style="margin-bottom:20rpx;">
    <view class="h3" style="margin-bottom:16rpx;">选择成员</view>
    <picker range="{{playerOptions}}" bindchange="pickPlayer"><view class="input">{{mode==='all'?'全选（全部成员）':'请选择玩家'}}</view></picker>
  </view>
  <block wx:if="{{mode==='all'}}">
    <view class="card" style="margin-bottom:20rpx;">
      <view class="h3" style="margin-bottom:16rpx;">时间范围</view>
      <view class="muted">起始</view>
      <view class="row">
        <picker mode="date" value="{{startDate}}" bindchange="onStartDate"><view class="input grow">{{startDate || '选择日期'}}</view></picker>
        <picker mode="time" value="{{startTime}}" bindchange="onStartTime"><view class="input grow">{{startTime}}</view></picker>
      </view>
      <view class="muted">结束</view>
      <view class="row">
        <picker mode="date" value="{{endDate}}" bindchange="onEndDate"><view class="input grow">{{endDate || '选择日期'}}</view></picker>
        <picker mode="time" value="{{endTime}}" bindchange="onEndTime"><view class="input grow">{{endTime}}</view></picker>
      </view>
    </view>
    <view class="card">
      <view class="h3" style="margin-bottom:16rpx;">全体成员变化值</view>
      <view class="arow th"><view class="grow">玩家</view><view class="av">Δ武勋</view><view class="av">Δ势力</view><view class="av">Δ总贡献</view><view class="av">Δ周贡献</view></view>
      <view class="arow" wx:for="{{allList}}" wx:key="index"><view class="grow">{{item.name}}</view><view class="av">{{item.dMerit}}</view><view class="av">{{item.dPower}}</view><view class="av">{{item.dCt}}</view><view class="av">{{item.dCw}}</view></view>
      <view wx:if="{{allList.length===0}}" class="muted" style="text-align:center;padding:30rpx;">暂无数据</view>
    </view>
  </block>
  <block wx:else>
    <view class="card" style="margin-bottom:20rpx;" wx:if="{{recs.length}}">
      <view class="h3" style="margin-bottom:16rpx;">两次快照</view>
      <view class="muted">起始</view>
      <picker range="{{recOptions}}" bindchange="pickStart"><view class="input">{{recOptions[startIdx]}}</view></picker>
      <view class="muted">结束</view>
      <picker range="{{recOptions}}" bindchange="pickEnd"><view class="input">{{recOptions[endIdx]}}</view></picker>
      <button class="btn" bindtap="calc">计算变化值</button>
    </view>
    <view class="card" wx:if="{{result}}">
      <view class="h3" style="margin-bottom:16rpx;">变化值（结束 − 起始）</view>
      <view class="cmp"><view>武勋</view><view class="cmpv">{{result.dMerit}}</view></view>
      <view class="cmp"><view>势力值</view><view class="cmpv">{{result.dPower}}</view></view>
      <view class="cmp"><view>贡献总量</view><view class="cmpv">{{result.dCt}}</view></view>
      <view class="cmp"><view>贡献周量</view><view class="cmpv">{{result.dCw}}</view></view>
    </view>
    <view wx:if="{{mode==='single' && !recs.length}}" class="muted" style="text-align:center;padding:40rpx;">该玩家还没有记录</view>
  </block>
</view>